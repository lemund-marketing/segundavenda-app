<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false": o backup do Google não leva junto a sessão de login,
         que fica guardada no armazenamento do WebView. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Notificação de oportunidade de venda (FCM). Com o app fechado é o
             Android que desenha a notificação: estes dois valem quando a
             mensagem não traz ícone ou canal (a edge manda os dois, iguais a
             estes). O canal "oportunidades" é criado pelo app ao abrir
             (src/app/nativo/push.ts); antes disso o Android usa o canal
             genérico do Firebase. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notificacao" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="oportunidades" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sem esta (permissão normal, não pergunta nada), o WebView não acompanha
         a rede: navigator.onLine fica sempre true e os eventos online/offline
         não chegam, e o "Sem internet" e a recarga quando a rede volta não
         funcionam. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 ou mais novo: sem esta (pergunta à pessoa), a notificação
         de oportunidade não aparece. O app pede uma vez, depois do login. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
